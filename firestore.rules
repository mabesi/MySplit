rules_version = '2';

// Firestore rules for MySplit.
//
// Membership is checked against two string arrays stored on the group:
//   memberIds        - every member (active or pending)
//   activeMemberIds  - only active members
// Both are derived from `members` by the app. The owner is always members[0].
//
// Existing groups created before these arrays existed must be opened once by
// the owner; the app enqueues a backfill update when it sees a group without
// them. Non-owner writes to those groups stay blocked until the owner migrates.
//
// Rules cannot verify that every entry of the arrays corresponds to a member
// object (no list iteration), but they enforce sizes, uniqueness, that every
// active id is also a member id, and that the owner is in both arrays.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------
    // Basic helpers
    // ---------------------------------------------------------------------

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function isOwner(data) {
      return signedIn() && data.ownerId == uid();
    }

    function memberIdsOf(data) {
      return data.get('memberIds', []);
    }

    function activeMemberIdsOf(data) {
      return data.get('activeMemberIds', []);
    }

    function isMember(data) {
      return signedIn() && uid() in memberIdsOf(data);
    }

    function isActiveMember(data) {
      return signedIn() && uid() in activeMemberIdsOf(data);
    }

    function normalizedName(name) {
      return name.trim().lower();
    }

    // The owner entry is fixed at index 0 (enforced by create and
    // canManageMembers).
    function isOwnerName(data, candidate) {
      return data.members.size() > 0 &&
        data.members[0].name is string &&
        normalizedName(data.members[0].name) == normalizedName(candidate);
    }

    // ---------------------------------------------------------------------
    // Shape validation
    // ---------------------------------------------------------------------

    function validMember(m) {
      return m.keys().hasAll(['id', 'name']) &&
        m.id is string && m.id.size() > 0 && m.id.size() <= 128 &&
        m.name is string && normalizedName(m.name).size() > 0 && m.name.size() <= 100 &&
        (!('status' in m) || m.status in ['active', 'pending']) &&
        (!('virtual' in m) || m.virtual is bool) &&
        (!('email' in m) || m.email is string) &&
        (!('avatarUrl' in m) || m.avatarUrl is string);
    }

    function validExpense(e) {
      return e.keys().hasAll(['id', 'title', 'amount', 'paidBy', 'splitAmong', 'date']) &&
        e.id is string && e.id.size() > 0 && e.id.size() <= 128 &&
        e.title is string && e.title.size() > 0 && e.title.size() <= 1000 &&
        (e.amount is int || e.amount is float) &&
        e.amount > 0 && e.amount < 1000000000 &&
        e.paidBy is string && e.paidBy.size() > 0 &&
        e.splitAmong is list &&
        e.splitAmong.size() > 0 && e.splitAmong.size() <= 100 &&
        e.splitAmong.toSet().size() == e.splitAmong.size() &&
        (!('settlement' in e) || e.settlement is bool) &&
        (e.date is int || e.date is float);
    }

    function validIdArrays(data) {
      let ids = data.get('memberIds', []);
      let active = data.get('activeMemberIds', []);
      return ids is list &&
        active is list &&
        ids.size() == data.members.size() &&
        ids.toSet().size() == ids.size() &&
        active.toSet().size() == active.size() &&
        active.hasOnly(ids) &&
        data.ownerId in ids &&
        data.ownerId in active;
    }

    // ---------------------------------------------------------------------
    // Diff and immutability helpers
    // ---------------------------------------------------------------------

    function addedMembers(oldData) {
      return request.resource.data.members.removeAll(oldData.members);
    }

    function removedMembers(oldData) {
      return oldData.members.removeAll(request.resource.data.members);
    }

    function addedExpenses(oldData) {
      return request.resource.data.expenses.removeAll(oldData.expenses);
    }

    function removedExpenses(oldData) {
      return oldData.expenses.removeAll(request.resource.data.expenses);
    }

    function sameMeta(oldData) {
      return request.resource.data.id == oldData.id &&
        request.resource.data.ownerId == oldData.ownerId &&
        request.resource.data.createdAt == oldData.createdAt &&
        request.resource.data.version == oldData.version;
    }

    function sameSummary(oldData) {
      return request.resource.data.name == oldData.name &&
        request.resource.data.get('imageUrl', '') == oldData.get('imageUrl', '');
    }

    function hasSameMembers(oldData) {
      return request.resource.data.members == oldData.members;
    }

    function hasSameExpenses(oldData) {
      return request.resource.data.expenses == oldData.expenses;
    }

    function hasSameMemberIds(oldData) {
      return request.resource.data.get('memberIds', []) == oldData.get('memberIds', []);
    }

    function hasSameActiveMemberIds(oldData) {
      return request.resource.data.get('activeMemberIds', []) ==
        oldData.get('activeMemberIds', []);
    }

    function validUpdatedAt() {
      return request.resource.data.updatedAt is int ||
        request.resource.data.updatedAt is float;
    }

    function sameCurrency(oldData) {
      return request.resource.data.get('currency', '') ==
        oldData.get('currency', '');
    }

    function validCurrency(currency) {
      return currency is string && currency.matches('^[A-Z]{3}$');
    }

    // New images must be small thumbnails. An unchanged legacy image is allowed
    // regardless of size so old groups can still be renamed/managed.
    function canUpdateImage(oldData) {
      let next = request.resource.data.get('imageUrl', '');
      let previous = oldData.get('imageUrl', '');
      return !('imageUrl' in request.resource.data) ||
        next == previous ||
        (next is string && next.size() <= 200000);
    }

    function isNameUpdateAllowed(oldData, added) {
      return added.size() == 0 ||
        (added.size() == 1 &&
          added[0].keys().hasAll(['id', 'name']) &&
          added[0].id != oldData.ownerId &&
          added[0].name is string &&
          !isOwnerName(oldData, added[0].name));
    }

    // ---------------------------------------------------------------------
    // Update branches
    // ---------------------------------------------------------------------

    // A non-member appends themselves as a pending request. The memberIds
    // array becomes exactly the old list plus the caller; activeMemberIds is
    // unchanged (they are not active yet).
    function canSelfJoin(oldData, added, removed) {
      let oldIds = memberIdsOf(oldData);
      let newIds = request.resource.data.get('memberIds', []);
      return !isMember(oldData) &&
        added.size() == 1 &&
        removed.size() == 0 &&
        request.resource.data.members is list &&
        request.resource.data.members.size() == oldData.members.size() + 1 &&
        request.resource.data.members.size() <= 100 &&
        validMember(added[0]) &&
        added[0].id == uid() &&
        added[0].get('status', 'active') == 'pending' &&
        added[0].get('virtual', false) == false &&
        !isOwnerName(oldData, added[0].name) &&
        sameCurrency(oldData) &&
        newIds is list &&
        newIds.toSet().size() == newIds.size() &&
        newIds.size() == oldIds.size() + 1 &&
        uid() in newIds &&
        oldIds.hasOnly(newIds) &&
        newIds.size() == request.resource.data.members.size() &&
        request.resource.data.get('activeMemberIds', []) == activeMemberIdsOf(oldData);
    }

    // An active member appends a virtual member or a pending request. The id
    // arrays must change by exactly that member.
    function canAppendMember(oldData, added, removed) {
      let oldIds = memberIdsOf(oldData);
      let oldActive = activeMemberIdsOf(oldData);
      let newIds = request.resource.data.get('memberIds', []);
      let newActive = request.resource.data.get('activeMemberIds', []);
      let member = added.size() == 1 ? added[0] : null;
      return isActiveMember(oldData) &&
        added.size() == 1 &&
        removed.size() == 0 &&
        request.resource.data.members is list &&
        request.resource.data.members.size() == oldData.members.size() + 1 &&
        request.resource.data.members.size() <= 100 &&
        validMember(member) &&
        !(member.id in oldIds) &&
        !isOwnerName(oldData, member.name) &&
        sameCurrency(oldData) &&
        newIds is list &&
        newIds.toSet().size() == newIds.size() &&
        newIds.size() == oldIds.size() + 1 &&
        member.id in newIds &&
        oldIds.hasOnly(newIds) &&
        newIds.size() == request.resource.data.members.size() &&
        (
          (member.get('virtual', false) == true &&
            member.get('status', 'active') == 'active' &&
            newActive is list &&
            newActive.toSet().size() == newActive.size() &&
            newActive.size() == oldActive.size() + 1 &&
            member.id in newActive &&
            oldActive.hasOnly(newActive)) ||
          (member.get('virtual', false) == false &&
            member.get('status', 'active') == 'pending' &&
            newActive == oldActive)
        );
    }

    // An active member appends an expense created by themselves.
    function canAddExpense(oldData, added, removed) {
      let activeIds = activeMemberIdsOf(oldData);
      return isActiveMember(oldData) &&
        sameCurrency(oldData) &&
        hasSameMemberIds(oldData) &&
        hasSameActiveMemberIds(oldData) &&
        added.size() == 1 &&
        removed.size() == 0 &&
        request.resource.data.expenses is list &&
        request.resource.data.expenses.size() == oldData.expenses.size() + 1 &&
        validExpense(added[0]) &&
        added[0].keys().hasAll(['createdBy', 'createdAt']) &&
        added[0].createdBy == uid() &&
        added[0].createdAt is int &&
        added[0].paidBy in activeIds &&
        added[0].splitAmong.hasOnly(activeIds);
    }

    // The creator of an expense or the owner removes exactly one expense.
    function canDeleteExpense(oldData, added, removed) {
      return isActiveMember(oldData) &&
        sameCurrency(oldData) &&
        hasSameMemberIds(oldData) &&
        hasSameActiveMemberIds(oldData) &&
        added.size() == 0 &&
        removed.size() == 1 &&
        request.resource.data.expenses is list &&
        request.resource.data.expenses.size() == oldData.expenses.size() - 1 &&
        (removed[0].get('createdBy', '') == uid() || isOwner(oldData));
    }

    // The owner restructures members/expenses (add, remove, reject, approve and
    // merge), including the memberIds/activeMemberIds backfill. The owner entry
    // is fixed at index 0 and can never be removed.
    function canManageMembers(oldData, added) {
      return isOwner(oldData) &&
        sameCurrency(oldData) &&
        request.resource.data.members is list &&
        request.resource.data.members.size() > 0 &&
        request.resource.data.members.size() <= 100 &&
        request.resource.data.members[0] == oldData.members[0] &&
        request.resource.data.members[0].id == oldData.ownerId &&
        request.resource.data.members[0].get('status', 'active') == 'active' &&
        request.resource.data.expenses is list &&
        request.resource.data.expenses.size() <= 5000 &&
        validIdArrays(request.resource.data) &&
        isNameUpdateAllowed(oldData, added);
    }

    // The owner changes only the group name/image.
    function canUpdateSummary(oldData) {
      return isOwner(oldData) &&
        sameCurrency(oldData) &&
        hasSameMembers(oldData) &&
        hasSameExpenses(oldData) &&
        hasSameMemberIds(oldData) &&
        hasSameActiveMemberIds(oldData) &&
        sameMeta(oldData) &&
        request.resource.data.name is string &&
        normalizedName(request.resource.data.name).size() > 0 &&
        request.resource.data.name.size() <= 200 &&
        canUpdateImage(oldData) &&
        validUpdatedAt();
    }

    // Idempotent retries from the offline outbox (the server transaction
    // deduplicates the element, so only updatedAt changes on a replay).
    function isNoOpRetry(oldData) {
      return isMember(oldData) &&
        sameCurrency(oldData) &&
        sameMeta(oldData) &&
        sameSummary(oldData) &&
        hasSameMembers(oldData) &&
        hasSameExpenses(oldData) &&
        hasSameMemberIds(oldData) &&
        hasSameActiveMemberIds(oldData) &&
        validUpdatedAt();
    }

    // The owner can set or change the currency at any time. Values are not
    // converted; the currency only changes the symbol.
    function canUpdateCurrency(oldData) {
      return isOwner(oldData) &&
        hasSameMembers(oldData) &&
        hasSameExpenses(oldData) &&
        hasSameMemberIds(oldData) &&
        hasSameActiveMemberIds(oldData) &&
        sameMeta(oldData) &&
        sameSummary(oldData) &&
        validCurrency(request.resource.data.currency) &&
        validUpdatedAt();
    }

    function canUpdate(oldData) {
      let addedM = addedMembers(oldData);
      let removedM = removedMembers(oldData);
      let addedE = addedExpenses(oldData);
      let removedE = removedExpenses(oldData);
      let metaOk = sameMeta(oldData);
      let summarySame = sameSummary(oldData);
      let membersSame = hasSameMembers(oldData);
      let expensesSame = hasSameExpenses(oldData);
      let currencySame = sameCurrency(oldData);
      let owner = isOwner(oldData);

      return signedIn() && metaOk && validUpdatedAt() && (
        (owner && (
          (summarySame && currencySame && canManageMembers(oldData, addedM)) ||
          (membersSame && expensesSame && currencySame && canUpdateSummary(oldData)) ||
          (membersSame && expensesSame && summarySame && canUpdateCurrency(oldData))
        )) ||
        (summarySame && canSelfJoin(oldData, addedM, removedM)) ||
        (summarySame && canAppendMember(oldData, addedM, removedM)) ||
        (summarySame && membersSame && canAddExpense(oldData, addedE, removedE)) ||
        (summarySame && membersSame && canDeleteExpense(oldData, addedE, removedE)) ||
        (summarySame && membersSame && expensesSame && isNoOpRetry(oldData))
      );
    }

    // ---------------------------------------------------------------------
    // Groups collection
    // ---------------------------------------------------------------------

    match /groups/{groupId} {
      // Reading requires knowing the exact document ID. Collection listing is
      // only allowed for the two discovery queries below, which are always
      // constrained to the caller's own groups.
      // Reads are open to any signed-in user because joining requires knowing
      // the group ID and reading the document to build the pending request.
      // The ID is effectively the invitation secret. The client verifies
      // membership locally and drops groups the user no longer belongs to.
      allow get: if signedIn();
      allow list: if signedIn() &&
        request.query.limit <= 100 &&
        (
          resource.data.ownerId == uid() ||
          uid() in resource.data.get('memberIds', [])
        );

      // The creator must own the group and be its single initial member.
      allow create: if signedIn() &&
        request.resource.data.keys().hasOnly([
          'id', 'name', 'ownerId', 'createdAt', 'updatedAt', 'version',
          'members', 'expenses', 'memberIds', 'activeMemberIds', 'currency'
        ]) &&
        request.resource.data.id == groupId &&
        validCurrency(request.resource.data.currency) &&
        request.resource.data.ownerId == uid() &&
        request.resource.data.name is string &&
        normalizedName(request.resource.data.name).size() > 0 &&
        request.resource.data.name.size() <= 200 &&
        request.resource.data.createdAt is int &&
        request.resource.data.updatedAt is int &&
        request.resource.data.version == 1 &&
        request.resource.data.members is list &&
        request.resource.data.members.size() == 1 &&
        validMember(request.resource.data.members[0]) &&
        request.resource.data.members[0].id == uid() &&
        request.resource.data.members[0].get('status', 'active') == 'active' &&
        request.resource.data.expenses is list &&
        request.resource.data.expenses.size() == 0 &&
        request.resource.data.memberIds == [uid()] &&
        request.resource.data.activeMemberIds == [uid()];

      allow update: if canUpdate(resource.data);

      allow delete: if isOwner(resource.data);
    }
  }
}
